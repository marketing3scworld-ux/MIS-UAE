# ─────────────────────────────────────────────────────────────
# BME MIS — environment template.
# Copy to `.env` and fill in real values. NEVER commit or email `.env`.
# ─────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────
# PostgreSQL 16 connection string. Must match your DB credentials.
# For the bundled docker-compose (port 5432, user bme): keep as-is but change the password.
DATABASE_URL="postgresql://bme:CHANGE_ME@localhost:5432/bme_mis?schema=public"

# ── Auth (NextAuth / Auth.js v5, email + password) ───────────
# Generate the secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# The app's public URL. REQUIRED in production (login + email links break if wrong).
# NO trailing slash — Auth.js appends paths, so ".../" yields "//dashboard".
NEXTAUTH_URL="https://bmemisae.3sc.tech"

# ── Anthropic (Emirates-ID auto-fill / vision OCR) — optional ─
# Server-side only, never exposed to the browser. Unset => auto-fill falls back
# to manual entry (the rest of the app is unaffected).
# Get one from console.anthropic.com. NEVER put a real key in this file —
# .env.example is committed and shipped to others; put it in `.env` instead.
ANTHROPIC_API_KEY="sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optional: OCR model. Default claude-opus-5; set claude-sonnet-5 for a cheaper scan.
# EID_OCR_MODEL="claude-opus-5"

# ── SMTP (expiry-escalation emails) — optional ───────────────
# Unset SMTP_HOST => emails are logged to the server console instead of sent.
# SMTP_HOST is a MAIL SERVER hostname, not an email address. Gmail: smtp.gmail.com
# NEVER put a real app password in this file — it is committed and shipped.
SMTP_HOST=""
SMTP_PORT="587"
# SMTP_USER is the full email address you authenticate as.
SMTP_USER=""
# SMTP_PASS is a Google app password (16 chars), not the account login password.
SMTP_PASS=""
SMTP_FROM="BME MIS <no-reply@bmeventsksa.com>"

# ── File storage (required) ──────────────────────────────────
# Where uploaded documents are written. Use an ABSOLUTE path on backed-up storage
# in production. Behind a storage interface — swappable for S3 later.
UPLOAD_DIR="./uploads"

# ── Nightly expiry scan (optional) ───────────────────────────
# Cron expression + timezone for the in-process document-expiry scan.
# SCAN_CRON="0 2 * * *"
# SCAN_TZ="Asia/Dubai"

# ── Backups (optional) ───────────────────────────────────────
# Full path to pg_dump.exe if it isn't on PATH (used by `npm run backup`).
# PG_DUMP="C:\\Program Files\\PostgreSQL\\16\\bin\\pg_dump.exe"
